{
  "colors": {
    "base": {
      "bg": "#ffffff",
      "surface": "#fafafa",
      "border": "#e5e5e5",
      "overlay": "rgba(0, 0, 0, 0.45)"
    },
    "accent": {
      "primary": "#000000",
      "primaryHover": "#262626",
      "secondary": "#525252",
      "danger": "#b91c1c",
      "success": "#15803d",
      "warning": "#a16207"
    },
    "text": {
      "primary": "#171717",
      "secondary": "#525252",
      "muted": "#737373",
      "inverse": "#ffffff"
    },
    "glass": {
      "tint": "#fafafa",
      "tintHover": "#f5f5f5",
      "highlight": "#e5e5e5",
      "shadow": "rgba(0, 0, 0, 0.06)"
    }
  },
  "blur": {
    "none": "blur(0px)",
    "sm": "blur(0px)",
    "md": "blur(0px)",
    "lg": "blur(0px)",
    "xl": "blur(0px)",
    "elevation": {
      "0": "blur(0px)",
      "1": "blur(0px)",
      "2": "blur(0px)",
      "3": "blur(0px)",
      "4": "blur(0px)"
    }
  },
  "spacing": {
    "scale": [0, 4, 8, 12, 16, 24, 32, 48, 64, 96],
    "card": {
      "padding": "20px",
      "gap": "16px",
      "borderRadius": "6px"
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Inter', 'Helvetica Neue', sans-serif",
      "body": "'Inter', 'Helvetica Neue', sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.8125rem",
      "base": "0.9375rem",
      "lg": "1.0625rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "1.875rem",
      "4xl": "2.25rem"
    }
  },
  "animation": {
    "transition": {
      "default": "all 160ms ease",
      "glass": "background 160ms ease, border-color 160ms ease"
    }
  }
}