    "glass": {
      "tint": "#ffffff",
      "tintHover": "#f1f5f9",
      "highlight": "#e2e8f0",
      "shadow": "rgba(15, 23, 42, 0.08)"
    }
  },
  "blur": {
    "none": "blur(0px)",
    "sm": "blur(0px)",
    "md": "blur(0px)",
    "lg": "blur(0px)",
